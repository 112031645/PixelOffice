    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${sentinel.spring-boot.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <!-- 薄入口：模块自身类，再由它反射转发到 Sentinel Dashboard 的主类 -->
                    <mainClass>com.cloud.visual.sentinel.CloudSentinelApplication</mainClass>
                    <!-- 关键：把上面所有 system scope 的官方 jar 一并打进 fat jar 的 BOOT-INF/lib -->
                    <includeSystemScope>true</includeSystemScope>
                    <jvmArguments>
                        --add-opens java.base/java.lang=ALL-UNNAMED
                        --add-opens java.base/java.util=ALL-UNNAMED
                        --add-opens java.base/java.lang.reflect=ALL-UNNAMED
                    </jvmArguments>
                </configuration>
            </plugin>
        </plugins>
    </build>


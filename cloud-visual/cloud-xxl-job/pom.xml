                    <!-- 薄入口：模块自身类，再由它反射转发到调度中心的真实主类
                         （类名取自构建产物 MANIFEST 的 Start-Class：com.xxl.job.admin.XxlJobAdminApplication） -->
                    <mainClass>com.cloud.visual.xxljob.CloudXxljobApplication</mainClass>
                    <includeSystemScope>true</includeSystemScope>
                    <jvmArguments>
                        --add-opens java.base/java.lang=ALL-UNNAMED
                        --add-opens java.base/java.util=ALL-UNNAMED
                        --add-opens java.base/java.lang.reflect=ALL-UNNAMED
                    </jvmArguments>
                </configuration>
            </plugin>
        </plugins>

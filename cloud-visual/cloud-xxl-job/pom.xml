        <xxl-job.spring-boot.version>2.7.9</xxl-job.spring-boot.version>
        <xxljob.lib.path>${project.basedir}/lib</xxljob.lib.path>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
    </properties>

